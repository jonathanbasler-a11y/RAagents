# Create .env.local (git-ignored) from this file with owner-only permissions from the start:
#   install -m 600 env.example .env.local
# then fill it in. Never commit real values. In Ona, set the same names as your own user
# secrets instead. The app reads only these LLM_* names. ANTHROPIC_* or OPENAI_* variables
# are ignored.
# The base URL must be https, except for a model on this machine (localhost). A remote http
# URL is refused so a key never travels in clear text (LLM_ALLOW_PLAIN_HTTP=1 overrides it:
# do not set it for a remote endpoint).

# Agents route: an OpenAI-compatible chat-completions endpoint.
# Base URL up to and including the API version path, for example https://<your-gateway>/v1
LLM_BASE_URL=
LLM_API_KEY=
# Optional: the header that carries the key, if your gateway does not use
# "Authorization: Bearer <key>". Leave empty for the Bearer default.
LLM_API_KEY_HEADER=
# Exact model id as your gateway names it. No "latest" aliases.
LLM_MODEL=
# Optional: output token cap per reply (default 1500).
LLM_MAX_TOKENS=

# Judge route: must be a different model family from the agents.
# Base URL and key header default to the agents route when left empty.
LLM_JUDGE_MODEL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY_HEADER=

# A copy hosted for a team, behind HTTPS (README, "A hosted copy with accounts"). All optional: empty means off, and a
# copy on your own computer needs none of them.
# Sign-in with an account per person: the admin's password (16 or more random characters) and name (default "admin").
# The admin creates everyone else's account on the People page.
RAAGENTS_ADMIN_PASSWORD=
RAAGENTS_ADMIN_USERNAME=
# 1 behind exactly one load balancer that appends X-Forwarded-For (per-machine sign-in limits); empty or 0 otherwise.
RAAGENTS_TRUSTED_PROXY_HOPS=
# The container image always requires sign-in: without an admin password it starts locked, never open
# (RAAGENTS_REQUIRE_SIGN_IN; only 0 turns that off, so it is not listed here).
# The banner of the hosted copy; it also switches the agents' rule about where chats are kept.
RAAGENTS_HOSTED_NOTICE=
# A backup of the database in object storage (scripts/hosted/start.sh), e.g. s3://bucket/path/chat.db?region=eu-central-1
LITESTREAM_REPLICA_URL=
# 1 for the very first start only, when no backup exists yet.
LITESTREAM_ALLOW_EMPTY_START=
