# Copy this file to .env.local (git-ignored), fill it in, then: chmod 600 .env.local
#   cp env.example .env.local && chmod 600 .env.local
# Never commit real values. In Ona, set the same names as your own user secrets instead.
# The app reads only these LLM_* names. ANTHROPIC_* or OPENAI_* variables are ignored.

# Agents route: an OpenAI-compatible chat-completions endpoint.
# Base URL up to and including the API version path, for example https://<your-gateway>/v1
LLM_BASE_URL=
LLM_API_KEY=
# Optional: the header that carries the key, if your gateway does not use
# "Authorization: Bearer <key>". Leave empty for the Bearer default.
LLM_API_KEY_HEADER=
# Exact model id as your gateway names it. No "latest" aliases.
LLM_MODEL=
# Optional: output token cap per reply (default 1500).
LLM_MAX_TOKENS=

# Judge route: must be a different model family from the agents.
# Base URL and key header default to the agents route when left empty.
LLM_JUDGE_MODEL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY_HEADER=
