{
  "name": "hybrid-team-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Human Hybrid Team: named agent personas with a team chat and 1:1 rooms (demo).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H ${HOST:-127.0.0.1} -p ${PORT:-3200}",
    "build": "next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3200}",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --conditions=react-server scripts/smoke.ts",
    "avatars": "node scripts/make-avatars.mjs",
    "fake-llm": "node scripts/fake-llm.mjs",
    "demo": "node scripts/demo/demo.mjs live",
    "demo:practice": "node scripts/demo/demo.mjs practice",
    "demo:stop": "node scripts/demo/demo.mjs stop",
    "gate": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@next/env": "16.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "fsevents": false
  }
}
